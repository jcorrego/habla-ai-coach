# Habla DB driver: sqlite for local dev, mysql for Forge production.
HABLA_DB_DRIVER=sqlite

# SQLite local development.
HABLA_DB_PATH=data/habla.db

# MySQL 8 production on Laravel Forge.
# Keep real values only in Forge environment variables, never in Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=habla
MYSQL_USER=habla
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5
